Inicio 

	Intentos = 0 
	
	Mientras intentos < 3
		
		Escribe "Introduce la clave numérica: "
		Lee clave 
		
		Intentos = intentos + 1
		
		Si clave = 2468 entonces 
			Escribir "Acceso permitido."
			
			Fin
			
		SiNo 
			Escribir "Intentos restantes: " 3 - intentos
			
			FinSI
			
		FinMientras
	
	Escribir "Acceso bloqueado" 
		

Fin 